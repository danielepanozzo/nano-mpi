@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/nanompiTargets.cmake")

check_required_components(nanompi)

# nano-mpi installs a header named mpi.h. Anything that links nanompi::nanompi
# gets it on the include path and needs no other MPI.
set(NANOMPI_FOUND TRUE)
